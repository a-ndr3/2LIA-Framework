<configuration>
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener" />
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd-MM-yyyy HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="CONSOLE" />
    </root>

    <logger name="org.apache.kafka" level="off" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="org.springframework" level="off" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="org.apache.catalina" level="off" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="org.springdoc" level="off" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
</configuration>